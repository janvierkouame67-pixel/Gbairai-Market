{
  "rewrites": [
    {
      "source": "/vendre",
      "destination": "/api/share?v=1"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/share?b=:slug"
    },
    {
      "source": "/p/:id",
      "destination": "/api/share?p=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/resume",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/magique",
      "schedule": "0 19 * * *"
    }
  ]
}
